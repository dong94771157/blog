# ===== 博客后台管理环境变量 =====
# 在 EdgeOne Makers 控制台「项目设置 > 环境变量」中配置以下变量
# 本地开发可复制此文件为 .env.local 并修改

# 管理员用户名（默认 admin）
ADMIN_USERNAME=admin

# 管理员密码（默认 admin123，生产环境务必修改！）
ADMIN_PASSWORD=admin123

# JWT 签名密钥（生产环境务必设置为随机长字符串）
# 可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret

# ===== EdgeOne KV 绑定 =====
# 在 EdgeOne Makers 控制台「项目 > KV 存储」中绑定命名空间
# 变量名必须填：BLOG_KV
# 代码中通过全局变量 BLOG_KV 自动访问，无需在此配置