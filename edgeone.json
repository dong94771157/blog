{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {
    "nodejs": {
      "externalNodeModules": ["nodemailer", "qrcode"]
    }
  },
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}